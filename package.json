{
  "name": "folio-protocolo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.js",
    "build": "vite build",
    "build:railway": "npm run db:generate && npm run build",
    "start": "tsx server/index.js",
    "start:railway": "npm run db:deploy && npm run db:seed && npm start",
    "preview": "vite preview --host 127.0.0.1",
    "db:prepare": "tsx server/prepare-database.js",
    "predb:migrate": "npm run db:prepare",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "predb:deploy": "npm run db:prepare",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "attachments:migrate": "tsx scripts/migrate-attachments.js",
    "users": "tsx scripts/users.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.9.0",
    "@prisma/client": "7.9.0",
    "@radix-ui/react-popover": "1.1.20",
    "@radix-ui/react-select": "2.3.4",
    "cmdk": "1.1.1",
    "compression": "^1.8.1",
    "express": "5.2.1",
    "express-rate-limit": "8.6.0",
    "file-type": "22.0.1",
    "helmet": "8.3.0",
    "lucide-react": "1.25.0",
    "multer": "2.2.0",
    "pino-http": "11.0.0",
    "prisma": "7.9.0",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-router": "7.18.1",
    "tsx": "4.23.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "9.2.4",
    "jsdom": "29.1.1",
    "supertest": "7.2.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
