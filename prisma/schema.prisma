generator client {
  provider            = "prisma-client"
  output              = "../server/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
  runtime             = "nodejs"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  admin
  OPERATOR
  VIEWER
}

enum DocumentStatus {
  REGISTRADO
  ENVIADO
  RECEBIDO
  ARQUIVADO
  CANCELADO
}

enum HistoryAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  CANCEL
  ATTACHMENT_ADD
  ATTACHMENT_REMOVE
}

enum DataSubjectRequestType {
  ACCESS
  CORRECTION
  ANONYMIZATION
  DELETION
  PORTABILITY
  OPPOSITION
  CONSENT_REVOCATION
}

enum DataSubjectRequestStatus {
  OPEN
  IN_REVIEW
  COMPLETED
  REJECTED
}

enum RetentionPostAction {
  HARD_DELETE
  ANONYMIZE
  CRYPTO_SHRED
  BLOCK_AND_RETAIN
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  passwordHash     String
  passwordSalt     String
  role             UserRole          @default(VIEWER)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  responsibleFor   Document[]        @relation("ResponsibleUser")
  createdDocuments Document[]        @relation("CreatedByUser")
  updatedDocuments Document[]        @relation("UpdatedByUser")
  historyEntries   DocumentHistory[]
  // Legacy read-only compatibility. New protocol flows use DocumentLink.
  attachments      Attachment[]
  documentLinks    DocumentLink[]
  privacyRequests  DataSubjectRequest[] @relation("SubjectUser")
  createdPrivacyRequests DataSubjectRequest[] @relation("CreatedByUser")
  handledPrivacyRequests DataSubjectRequest[] @relation("HandledByUser")
  privacyRequestEvents PrivacyRequestEvent[]
  privacyRequestDeliveries PrivacyRequestDelivery[]
  privacyRequestMessagesSent PrivacyRequestMessage[] @relation("PrivacyMessageSender")
  privacyRequestMessagesReceived PrivacyRequestMessage[] @relation("PrivacyMessageRecipient")

  @@index([role, active])
}

model RetentionRule {
  id              String             @id @default(cuid())
  entityKey       String
  label           String
  purpose         String
  retentionMonths Int
  legalBasis      String
  postAction      RetentionPostAction @default(BLOCK_AND_RETAIN)
  triggeredBy     String
  notes           String             @default("")
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdById     String
  updatedById     String

  @@index([entityKey, active])
  @@index([updatedAt])
}

model PrivacySetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model PrivacyRequestRetentionLimit {
  id              String   @id @default(cuid())
  requestType     String   @unique
  maxRetentionDays Int
  notes           String   @default("")
  active          Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  updatedById     String

  @@index([active])
}

model Session {
  tokenHash  String   @id
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model DocumentType {
  id        String             @id @default(cuid())
  name      String
  prefix    String             @unique
  digits    Int                @default(3)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  documents Document[]
  sequences ProtocolSequence[]

  @@index([active])
}

model Department {
  id                   String     @id @default(cuid())
  name                 String
  code                 String     @unique
  active               Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  originDocuments      Document[] @relation("OriginDepartment")
  destinationDocuments Document[] @relation("DestinationDepartment")

  @@index([active])
}

model ProtocolSequence {
  typeId     String
  year       Int
  lastNumber Int          @default(0)
  type       DocumentType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@id([typeId, year])
}

model Document {
  id                      String            @id @default(cuid())
  protocol                String            @unique
  sequence                Int
  year                    Int
  typeId                  String
  date                    String
  originDepartmentId      String
  originCodeSnapshot      String
  originNameSnapshot      String
  destinationDepartmentId String?
  destinationText         String?
  destinationCodeSnapshot String?
  destinationNameSnapshot String
  subject                 String
  responsibleUserId       String
  status                  DocumentStatus    @default(REGISTRADO)
  notes                   String            @default("")
  createdById             String
  updatedById             String
  cancelledAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  type                    DocumentType      @relation(fields: [typeId], references: [id], onDelete: Restrict)
  originDepartment        Department        @relation("OriginDepartment", fields: [originDepartmentId], references: [id], onDelete: Restrict)
  destinationDepartment   Department?       @relation("DestinationDepartment", fields: [destinationDepartmentId], references: [id], onDelete: Restrict)
  responsibleUser         User              @relation("ResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  createdBy               User              @relation("CreatedByUser", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy               User              @relation("UpdatedByUser", fields: [updatedById], references: [id], onDelete: Restrict)
  history                 DocumentHistory[]
  // Legacy read-only compatibility. Do not use for new protocol records.
  attachments             Attachment[]
  links                   DocumentLink[]

  @@unique([typeId, year, sequence])
  @@index([date])
  @@index([year])
  @@index([status])
  @@index([typeId])
  @@index([originDepartmentId])
  @@index([destinationDepartmentId])
  @@index([responsibleUserId])
  @@index([createdById])
}

model DocumentHistory {
  id          String          @id @default(cuid())
  documentId  String
  action      HistoryAction
  fromStatus  DocumentStatus?
  toStatus    DocumentStatus?
  description String
  detailsJson String?
  userId      String
  createdAt   DateTime        @default(now())
  document    Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
  @@index([createdAt])
}

// Historical uploads are retained so existing databases remain readable.
// The active product flow must use DocumentLink and must not create new rows.
// Do not remove this model without a separately planned archival migration.
model Attachment {
  id           String   @id @default(cuid())
  documentId   String
  originalName String
  mimeType     String
  size         Int
  content      Bytes?
  storageKey   String?  @unique
  uploadedById String
  createdAt    DateTime @default(now())
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([documentId])
}

model DocumentLink {
  id          String   @id @default(cuid())
  documentId  String
  url         String
  provider    String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
  @@index([createdById])
}

model DataSubjectRequest {
  id            String                    @id @default(cuid())
  subjectUserId String
  createdById   String
  handledById   String?
  type          DataSubjectRequestType
  status        DataSubjectRequestStatus  @default(OPEN)
  description   String                    @default("")
  responseNote  String                    @default("")
  dueAt         DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  completedAt   DateTime?
  subjectUser   User                      @relation("SubjectUser", fields: [subjectUserId], references: [id], onDelete: Restrict)
  createdBy     User                      @relation("CreatedByUser", fields: [createdById], references: [id], onDelete: Restrict)
  handledBy     User?                     @relation("HandledByUser", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([subjectUserId, createdAt])
  @@index([status, dueAt])
  @@index([createdById, createdAt])
}

model PublicPrivacyRequest {
  id              String                    @id
  publicReference String                    @unique
  requesterName   String
  requesterEmail  String
  type            DataSubjectRequestType
  status          DataSubjectRequestStatus  @default(OPEN)
  description     String                    @default("")
  responseNote    String                    @default("")
  dueAt           DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  completedAt     DateTime?
  subjectUserId   String?
  identityVerifiedAt DateTime?
  identityVerifiedById String?

  @@index([status, dueAt])
  @@index([requesterEmail, createdAt])
}

model PrivacyRequestEvent {
  id        String   @id @default(cuid())
  requestId String
  source    String
  action    String
  note      String   @default("")
  actorId   String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, source, createdAt])
}

model PrivacyRequestDelivery {
  id             String   @id @default(cuid())
  requestId      String
  source         String
  format         String   @default("json")
  tokenHash      String   @unique
  recipientEmail String
  bundleHash     String
  expiresAt      DateTime
  downloadedAt   DateTime?
  createdAt      DateTime @default(now())
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([requestId, source, createdAt])
  @@index([expiresAt, downloadedAt])
}

model PrivacyRequestMessage {
  id              String   @id @default(cuid())
  requestId       String
  source          String
  senderId        String
  recipientUserId String?
  recipientScope  String
  body            String
  createdAt       DateTime @default(now())
  sender          User     @relation("PrivacyMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient       User?    @relation("PrivacyMessageRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([recipientUserId, createdAt])
}
